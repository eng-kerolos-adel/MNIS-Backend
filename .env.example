# PostgreSQL connection strings (pooler for runtime, direct for Prisma migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&connect_timeout=30

# Cryptographic keys (generate distinct 32-byte base64 or random secrets in production)
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-with-distinct-32-plus-char-random-secret
RX_SIGNING_KEY=replace-with-32-plus-char-hmac-secret
BLIND_INDEX_KEY=replace-with-32-plus-char-blind-index-secret
ENCRYPTION_KEY=replace-with-base64-encoded-32-bytes-key

# Token TTL & network config
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
PORT=3001
CORS_ORIGINS=https://mnis-egypt-dev.web.app,https://mnis-egypt-dev-citizen.web.app,http://localhost:3000
SWAGGER_ENABLED=false
TRUST_PROXY_HOPS=2

# Firebase Admin Project ID
MNIS_FIREBASE_PROJECT_ID=mnis-egypt-dev
